# --- credentials / env ---
.env
.env.*
*.cdsapirc
.copernicusmarine/
config/credentials*.yml

# --- scientific data (never commit) ---
*.nc
*.nc4
*.grib
*.grib2
*.h5
*.hdf5
*.zarr/
*.zip
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# --- python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
.venv/
venv/

# --- outputs that are large / regenerable ---
outputs/figures/*.png
outputs/logs/*.log

*.npy
outputs/embeddings/
outputs/targets_cache/

# Phase 7B local application
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
web/*.tsbuildinfo
outputs/phase7b/*.log
outputs/phase7b/test-field.json
outputs/phase7/replay_cache/
# Phase 8A: NRT products fetched from the provider, not project artifacts.
outputs/phase8a/cache/
# Runtime telemetry snapshot: rewritten on every successful refresh.
outputs/phase8a/last_successful_telemetry.json
outputs/phase8b/cache/
outputs/phase8b/latest_snapshot/
outputs/phase8b/daily_cache/
outputs/phase8b/discovery_cache.json
